// Smelly Melly — E-commerce for handmade bath & body products
// Uses the shared PostgreSQL database with its own schema namespace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["smellymelly"]
}

// ─── PRODUCTS ─────────────────────────────────────────────────────────────

model SM_Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shared base recipe for every product in this category. Each product can
  // still add its own one-off extras via SM_Product.ingredients.
  baseIngredients String?

  // Visual icon for the admin tile + public /shop pill. Either a single
  // emoji char OR a URL to an uploaded image. When both are set, the
  // image wins.
  iconEmoji    String?
  iconImageUrl String?

  /// Scent-sheet-specific icons. Independent from the website icons
  /// above so Mel can use marketing-quality images for the storefront
  /// while still picking compact emoji/SVG for the scent sheet's
  /// 14×14 chip rendering. Falls back to the website icons when null.
  iconSheetEmoji    String?
  iconSheetImageUrl String?

  products   SM_Product[]
  scentLinks SM_ScentCategory[]

  @@map("sm_categories")
  @@schema("smellymelly")
}

// Common allergens / ingredients-of-concern, scanned against each
// product's category baseIngredients + per-product extras. Renders as
// a "Contains X" pill on the product page when matched. Mel manages
// this list in /admin/settings — no code changes needed to add/edit.
model SM_Allergen {
  id        String   @id @default(cuid())
  label     String   // pill text, e.g. "Shea"
  // Comma-separated terms to match (case-insensitive, word-boundary).
  // e.g. "shea" or "beeswax, bees wax". Built into a regex at scan time.
  matchTerms String
  // "high" → red pill (top-tier nut/dairy concerns)
  // "normal" → amber pill (everything else)
  severity  String   @default("normal")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sm_allergens")
  @@schema("smellymelly")
}

model SM_Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  scent       String?
  ingredients String?
  categoryId  String
  category    SM_Category @relation(fields: [categoryId], references: [id])
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  /// Surfaces on the /gifts collection — curated gift sets / bundles.
  isGiftSet   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variants SM_ProductVariant[]
  images   SM_ProductImage[]
  recipes  SM_Recipe[]
  reviews  SM_Review[]

  @@map("sm_products")
  @@schema("smellymelly")
}

/// Customer product reviews. New reviews land unapproved; Mel approves them
/// in /admin/reviews before they show on the storefront.
model SM_Review {
  id         String     @id @default(cuid())
  productId  String
  product    SM_Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int // 1-5
  title      String?
  body       String     @db.Text
  isApproved Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([productId])
  @@index([isApproved])
  @@map("sm_reviews")
  @@schema("smellymelly")
}

model SM_ProductVariant {
  id            String     @id @default(cuid())
  productId     String
  product       SM_Product @relation(fields: [productId], references: [id])
  name          String
  sku           String?    @unique
  priceCents    Int
  costCents     Int?
  weightOz      Float?
  stockQuantity Int        @default(0)
  lowStockAt    Int        @default(5)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orderItems       SM_OrderItem[]
  campaignVariants SM_CampaignVariant[]

  @@map("sm_product_variants")
  @@schema("smellymelly")
}

model SM_ProductImage {
  id        String     @id @default(cuid())
  productId String
  product   SM_Product @relation(fields: [productId], references: [id])
  url       String
  altText   String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@map("sm_product_images")
  @@schema("smellymelly")
}

// ─── SCENTS (reusable scent options) ──────────────────────────────────────

model SM_Scent {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Customer-facing scent description. Initially AI-generated via the
  /// /admin/scents/descriptions tool, then editable. Renders on the
  /// printable scent-descriptions paper form.
  description String? @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  /// Include this scent on the printable scent-descriptions sheet. Default
  /// true so every existing scent keeps printing. Unchecking it in
  /// /admin/scents/descriptions hides the scent from /scent-descriptions/print
  /// without disabling it everywhere — used to drop out-of-stock or
  /// duplicate entries from the printed copy. Distinct from isActive.
  onDescriptionSheet Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuGroupLinks SM_MenuGroupScent[]
  categoryLinks  SM_ScentCategory[]
  aliases        SM_ScentAlias[]

  @@map("sm_scents")
  @@schema("smellymelly")
}

/// Maps a free-text scent string (typically the prefix parsed out of a
/// product variant name like "Bubblegum" or "chamomile & Lavander") to
/// a canonical SM_Scent. Used so the customer-facing /shop/[slug] page
/// can resolve a description for variants whose scent prefix doesn't
/// exactly match an SM_Scent.name. Curated via /admin/scents/variant-map.
model SM_ScentAlias {
  id        String   @id @default(cuid())
  /// The variant-side scent string. Stored case-insensitively (lowercased on write);
  /// resolver also lowercases on read. Unique so the same alias can't point to two scents.
  alias     String   @unique
  scentId   String
  scent     SM_Scent @relation(fields: [scentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([scentId])
  @@map("sm_scent_aliases")
  @@schema("smellymelly")
}

/// Independent of menu-group membership: marks which categories a
/// scent is "available for" on the printable scent sheet. Toggling a
/// link here does NOT add/remove the scent from the menu groups —
/// those still live in SM_MenuGroupScent. Two parallel datasets by
/// design (per Mel 2026-05-06).
model SM_ScentCategory {
  id         String      @id @default(cuid())
  scentId    String
  categoryId String
  scent      SM_Scent    @relation(fields: [scentId], references: [id], onDelete: Cascade)
  category   SM_Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([scentId, categoryId])
  @@index([scentId])
  @@index([categoryId])
  @@map("sm_scent_categories")
  @@schema("smellymelly")
}

// ─── PUBLIC MENU (curated scent board) ────────────────────────────────────
// Display layer for /menu and /menu/print. Independent from SM_Category
// because category taxonomy is coarser (e.g. "Bath & Body" covers both
// Body Scrub and Body Butter, but the menu lists them as separate cards).
// A scent can appear in multiple groups via the join table.

model SM_MenuGroup {
  id           String   @id @default(cuid())
  // Internal name (admin board column header).
  name         String
  // Public-facing card title. Falls back to name when null.
  displayLabel String?
  // e.g. "4 oz · $10–$12" — free-form, shown in the card head.
  priceLabel   String?
  // Color-theme key matched in /menu CSS: scrub, butter, beard, lip, scrub2.
  theme        String   @default("scrub")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  /// When true, this card spans both columns of the 2-up grid in the
  /// rendered menu. Used to be implicit (first card always wide); now
  /// explicit per-group so Mel can pick any card to be wide.
  fullWidth    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scentLinks SM_MenuGroupScent[]

  @@map("sm_menu_groups")
  @@schema("smellymelly")
}

model SM_MenuGroupScent {
  id        String       @id @default(cuid())
  groupId   String
  group     SM_MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scentId   String
  scent     SM_Scent     @relation(fields: [scentId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([groupId, scentId])
  @@index([groupId, sortOrder])
  @@map("sm_menu_group_scents")
  @@schema("smellymelly")
}

// ─── ORDERS ───────────────────────────────────────────────────────────────

enum SM_OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  PICKED_UP
  CANCELLED
  REFUNDED

  @@schema("smellymelly")
}

enum SM_FulfillmentType {
  SHIP
  PICKUP
  /// Campaign fulfillment — Mel hands the consolidated bundle to the
  /// campaign host, who distributes to buyers at the party/event.
  HOST_DELIVERY

  @@schema("smellymelly")
}

enum SM_PaymentMethod {
  // Card via Stripe (embedded Payment Element) — the live card processor.
  STRIPE_CARD
  // Legacy Square values — never activated in production. Kept so historical
  // orders and the column default stay valid; no longer offered at checkout.
  SQUARE_CARD
  SQUARE_CASH_APP
  // Manual = buyer sends money directly via Venmo / Cash App / etc.
  // Order stays PENDING until admin marks it PAID.
  MANUAL

  @@schema("smellymelly")
}

model SM_Order {
  id          String             @id @default(cuid())
  orderNumber Int                @unique @default(autoincrement())
  status      SM_OrderStatus     @default(PENDING)
  fulfillment SM_FulfillmentType

  // Gift options chosen at checkout — giftMessage prints on the packing note.
  isGift      Boolean @default(false)
  giftMessage String?

  // Customer (populated post-checkout by upsertCustomerFromOrder)
  customerId String?
  customer   SM_Customer? @relation(fields: [customerId], references: [id])

  // Snapshot of customer info at time of order (source of truth for the order)
  customerName  String
  customerEmail String
  customerPhone String?

  // Shipping (null for pickup)
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?

  // Money (all in cents)
  subtotalCents Int
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int

  // Promo/discount code applied at checkout (null if none). discountCents is
  // the amount taken off the merchandise subtotal.
  discountCode  String?
  discountCents Int     @default(0)

  // Payment tracking
  paymentMethod   SM_PaymentMethod @default(SQUARE_CARD)
  // For MANUAL tender — filled in by admin when marking the order paid.
  // Free-form so "Venmo 4/18", "Cash App @melissaj", "Check #301" all work.
  manualPaymentNote String?
  squarePaymentId String?
  squareOrderId   String?
  stripePaymentIntentId String?

  // Shipping
  trackingNumber String?
  shippingLabel  String?
  shippedAt      DateTime?

  // Timestamps
  paidAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Campaign / fundraiser — present when the order came through a
  // /party/[slug] page. Null for regular storefront orders.
  campaignId String?
  campaign   SM_Campaign? @relation(fields: [campaignId], references: [id])

  items SM_OrderItem[]

  @@map("sm_orders")
  @@schema("smellymelly")
}

model SM_OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       SM_Order          @relation(fields: [orderId], references: [id])
  variantId   String
  variant     SM_ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  variantName String
  quantity    Int
  unitCents   Int
  totalCents  Int

  @@map("sm_order_items")
  @@schema("smellymelly")
}

// ─── FUNDRAISER CAMPAIGNS ─────────────────────────────────────────────────

enum SM_CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@schema("smellymelly")
}

/// A person hosting a fundraiser/party. Reusable across campaigns.
model SM_Host {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  /// Free-form payout notes (Venmo @handle, mailing address, etc.)
  payoutNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns SM_Campaign[]

  @@map("sm_hosts")
  @@schema("smellymelly")
}

/// A fundraiser campaign — single-price variants curated for one event.
/// Lives at /party/[slug]; host views status at /host/[hostToken].
model SM_Campaign {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  hostId      String
  host        SM_Host           @relation(fields: [hostId], references: [id])
  /// Opaque token used in /host/[token] magic-link URLs.
  hostToken   String            @unique
  /// What the buyer pays per item, regardless of the variant's retail price.
  customerPriceCents Int
  /// What Mel keeps per item sold. Host's cut = customerPriceCents − mellyCutCents.
  mellyCutCents      Int
  status      SM_CampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  variants SM_CampaignVariant[]
  orders   SM_Order[]

  @@map("sm_campaigns")
  @@schema("smellymelly")
}

/// Which product variants are sellable in a given campaign.
/// Editable-copy overrides for public pages. Each row overrides a
/// single copy block keyed by a dotted identifier like `about.intro`.
/// Missing rows fall through to the hardcoded fallback in
/// `app/lib/page-text.ts` — that's also where the full key registry
/// lives, so new editable blocks get added in code first.
model SM_PageText {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("sm_page_text")
  @@schema("smellymelly")
}

model SM_CampaignVariant {
  id         String   @id @default(cuid())
  campaignId String
  campaign   SM_Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variantId  String
  variant    SM_ProductVariant @relation(fields: [variantId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([campaignId, variantId])
  @@map("sm_campaign_variants")
  @@schema("smellymelly")
}

// ─── CUSTOMERS (CRM) ──────────────────────────────────────────────────────

model SM_Customer {
  id    String  @id @default(cuid())
  // Always stored lowercased + trimmed; unique dedupe key.
  email String  @unique
  name  String
  phone String?
  notes String  @default("")

  // Denormalized stats — maintained by recomputeCustomerStats(email).
  // PAID-or-later orders only; CANCELLED/REFUNDED excluded from totals.
  orderCount      Int       @default(0)
  totalSpentCents Int       @default(0)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?

  // Last-known ship-to snapshot (from most recent SHIP order).
  lastShipName    String?
  lastShipAddress String?
  lastShipCity    String?
  lastShipState   String?
  lastShipZip     String?

  // Phase 7 — wholesale + birthdays + email-broadcast tracking.
  // wholesaleDiscountPct is applied on the subtotal at checkout (0-100).
  birthday             DateTime?
  wholesaleDiscountPct Int        @default(0)
  thankYouEmailSentAt  DateTime?
  lastReEngagementAt   DateTime?
  // Year of the last birthday email sent so we only send once per year.
  lastBirthdayEmailYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SM_Order[]
  tags   SM_CustomerTag[]

  @@map("sm_customers")
  @@schema("smellymelly")
}

model SM_Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#C67D4A")
  createdAt DateTime @default(now())

  customers SM_CustomerTag[]

  @@map("sm_tags")
  @@schema("smellymelly")
}

model SM_CustomerTag {
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer SM_Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      SM_Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("sm_customer_tags")
  @@schema("smellymelly")
}

// ─── INVOICES ─────────────────────────────────────────────────────────────

enum SM_InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED

  @@schema("smellymelly")
}

model SM_Invoice {
  id            String           @id @default(cuid())
  invoiceNumber Int              @unique @default(autoincrement())
  status        SM_InvoiceStatus @default(DRAFT)
  orderId       String?

  customerName  String
  customerEmail String?

  subtotalCents Int
  taxCents      Int @default(0)
  totalCents    Int

  notes     String?
  sentAt    DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items SM_InvoiceItem[]

  @@map("sm_invoices")
  @@schema("smellymelly")
}

model SM_InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     SM_Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int        @default(1)
  unitCents   Int
  totalCents  Int

  @@map("sm_invoice_items")
  @@schema("smellymelly")
}

// ─── DISCOUNT / PROMO CODES ──────────────────────────────────────────────

enum SM_DiscountType {
  PERCENT // value = 0-100, percent off the (post-wholesale) merchandise subtotal
  FIXED // value = cents off, capped at the merchandise subtotal

  @@schema("smellymelly")
}

/// A storefront promo code applied at checkout. Discount is taken on the
/// merchandise subtotal (after any wholesale discount, before tax/shipping).
/// usedCount is incremented ONLY after payment succeeds (see checkout route).
model SM_DiscountCode {
  id   String          @id @default(cuid())
  /// Stored uppercased; matched case-insensitively at checkout.
  code String          @unique
  type SM_DiscountType @default(PERCENT)
  /// PERCENT: whole percent (0-100). FIXED: cents off.
  value Int

  isActive         Boolean   @default(true)
  /// 0 = unlimited redemptions.
  maxUses          Int       @default(0)
  usedCount        Int       @default(0)
  /// Order must reach this merchandise subtotal (cents) to qualify. 0 = none.
  minSubtotalCents Int       @default(0)
  expiresAt        DateTime?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sm_discount_codes")
  @@schema("smellymelly")
}

// ─── RECIPES & MATERIALS (cost of goods) ─────────────────────────────────

model SM_Material {
  id               String   @id @default(cuid())
  name             String   @unique
  packageCostCents Int // what she paid for the package
  packageSize      Float // e.g. 16
  packageUnit      String // oz, g, lb, ml, fl_oz, drops, count
  supplier         String? // where she buys it
  notes            String?
  /// On-hand quantity in packageUnit; decremented when a batch is made.
  onHand        Float  @default(0)
  /// Alert threshold (packageUnit); at/below this it shows on the shopping list.
  reorderPoint  Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipeItems SM_RecipeItem[]

  @@map("sm_materials")
  @@schema("smellymelly")
}

model SM_Recipe {
  id        String      @id @default(cuid())
  name      String // e.g. "Body Scrub — Lemon Frost"
  productId String? // optional link to SM_Product
  product   SM_Product? @relation(fields: [productId], references: [id])
  yields    Int         @default(1) // how many units one batch makes
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items SM_RecipeItem[]

  @@map("sm_recipes")
  @@schema("smellymelly")
}

model SM_RecipeItem {
  id         String      @id @default(cuid())
  recipeId   String
  recipe     SM_Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialId String
  material   SM_Material @relation(fields: [materialId], references: [id])
  quantity   Float // how much of the material is used
  unit       String // oz, g, lb, ml, fl_oz, drops, count

  @@map("sm_recipe_items")
  @@schema("smellymelly")
}

// ─── SETTINGS ─────────────────────────────────────────────────────────────

/// Saved filter presets for the admin Orders screen. Global (single shared
/// admin login — no per-user views). SYSTEM views are seeded + immutable.
model SM_OrderView {
  id           String   @id @default(cuid())
  name         String
  filters      Json // OrderFilters shape — see app/lib/order-views.ts
  sort         Json? // reserved; null = default createdAt desc
  isSystem     Boolean  @default(false)
  icon         String? // optional emoji
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sm_order_views")
  @@schema("smellymelly")
}

/// Custom-order + wholesale requests submitted from the storefront.
model SM_Inquiry {
  id        String   @id @default(cuid())
  type      String // 'CUSTOM' | 'WHOLESALE'
  name      String
  email     String
  phone     String?
  business  String? // wholesale business name
  message   String   @db.Text
  status    String   @default("NEW") // NEW | IN_PROGRESS | CLOSED
  createdAt DateTime @default(now())

  @@index([status])
  @@map("sm_inquiries")
  @@schema("smellymelly")
}

model SM_Settings {
  id            String  @id @default("singleton")
  businessName  String  @default("Smelly Melly")
  businessEmail String?
  businessPhone String?
  address       String?
  city          String?
  state         String?
  zip           String?
  taxRate       Float   @default(0.06)

  /// Path under /api/uploads/logo/... when Mel has uploaded a brand mark.
  /// Null means the wordmark "Smelly Melly" renders everywhere instead.
  logoUrl String?

  // Maintenance / "under construction" mode. When true, public visitors see
  // the /maintenance page and public APIs (checkout, contact, shipping) 503.
  // Admins with a valid sm_admin cookie bypass so they can still preview.
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("")

  // Site-wide announcement banner (top of every storefront page). Shown only
  // when announcementActive is true and announcementText is non-empty.
  // announcementLink is optional — when set, the banner links there.
  announcementActive Boolean @default(false)
  announcementText   String  @default("")
  announcementLink   String  @default("")

  // Manual payment handles — shown on the order confirmation screen + email
  // when the buyer picks "Pay directly via Venmo / Cash App" at checkout.
  venmoHandle         String @default("")
  cashAppTag          String @default("")
  paymentInstructions String @default("")

  // Legal/CYA blurb appended to the Ingredients & Disclosure box on every
  // product page. Pair this with SM_Category.baseIngredients (shared recipe
  // per product type) and SM_Product.ingredients (per-product extras).
  productDisclaimer String @default("Handmade in small batches in Cumberland, MD. May contain nuts, shea, beeswax, essential oils, or fragrance oils. Patch-test on a small area before full use and discontinue if irritation occurs. For external use only — keep out of reach of children. Not evaluated by the FDA; not intended to diagnose, treat, cure, or prevent any disease.")

  /// Page orientation for the printed scent menu — chosen in the
  /// admin layout preview. "LANDSCAPE" or "PORTRAIT". Drives the
  /// @page size CSS that PrintShell injects, and the page-frame
  /// dimensions in the layout preview.
  menuOrientation String @default("LANDSCAPE")

  @@map("sm_settings")
  @@schema("smellymelly")
}

// Rolling sample of Mel's own user messages to /admin/ai. Used to nudge
// Claude on her phrasing style ("she calls 4oz tubs 'big tubs'", "she
// usually skips the dollar sign"). Capped at ~30 rows by the route handler;
// safe to wipe wholesale via /admin/ai/memory.
model SM_AIMessageSample {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sm_ai_message_samples")
  @@schema("smellymelly")
}
